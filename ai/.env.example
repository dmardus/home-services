# AI Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10200-10299 (see README > Port Allocation).

# --- Ports ---
OLLAMA_PORT=10200
OPENWEBUI_PORT=10201
N8N_PORT=10202
QDRANT_PORT=10230
PGVECTOR_PORT=10240

# --- User/Group IDs ---
PUID=1000
PGID=1000

# --- Ollama ---
OLLAMA_KEEP_ALIVE=1h
ENABLE_IMAGE_GENERATION=True

# --- Open WebUI ---
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_RAG_WEBSEARCH=True
RAG_WEB_SEARCH_ENGINE=searxng
RAG_WEB_SEARCH_RESULT_COUNT=10
RAG_WEB_SEARCH_CONCURRENT_REQUESTS=50
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>

# --- n8n ---
GENERIC_TIMEZONE=Canada/Edmonton
N8N_BASIC_AUTH_USER=n8n_user
N8N_BASIC_AUTH_PASSWORD=n&n_password
# Only matters once this stack sits behind a real reverse proxy/domain.
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:10202/
N8N_POSTGRES_PASSWORD=n8n_db_p@ssword

# --- Postgres (pgvector, long-term memory) ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
