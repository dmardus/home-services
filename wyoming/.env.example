# Home Assistant Stack (Wyoming voice services)
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10800-10899 (see README > Port Allocation).

# --- Ports ---
# Host port -> container's fixed Wyoming protocol port (10300 for Whisper, 10200 for Piper).
WHISPER_PORT=10800
PIPER_PORT=10801
