# Media Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10400-10499 (see README > Port Allocation).

# --- Ports ---
JELLYFIN_PORT=10400
PLEX_PORT=10401
NAVIDROME_PORT=10402

# --- Paths ---
# Root folder holding your media. Expects these subfolders beneath it:
#   movies/  demos/  photos/  tv-shows/  music/
MEDIA_PATH=/mnt/media

# --- User/Group IDs ---
# Used by Plex, Jellyfin, and Navidrome so files written by the containers are
# owned by a real user on the host. Match these to `id -u`/`id -g` for your user.
PUID=1000
PGID=1000

# --- Plex (optional, Plex Pass only) ---
# Only needed if you enable the PLEX_CLAIM line in docker-compose.yaml.
# Get a fresh token from https://plex.tv/claim (expires in ~4 minutes) right before starting.
PLEX_CLAIM=your_plex_claim_code_if_you_bought_it
