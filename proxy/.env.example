# Proxy Stack
# Copy this file to .env and fill in your local domain before running Docker Compose.

LOCAL_DOMAIN=local.example.ca
CF_EMAIL=your@email.com
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# VictoriaMetrics remote-write authentication
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'replace-me'
# Keep the hash single-quoted so Docker Compose does not interpolate its $ characters.
VICTORIAMETRICS_USERNAME=alloy
VICTORIAMETRICS_PASSWORD_HASH='$2a$14$REPLACE_WITH_CADDY_HASH'
# Space-separated client addresses or CIDR ranges accepted by Caddy's remote_ip matcher.
VICTORIAMETRICS_ALLOWED_SOURCES=192.168.1.10/32 192.168.1.20/32 192.168.1.30/32

LOKI_USERNAME=loki
LOKI_PASSWORD_HASH='$2a$14$REPLACE_WITH_CADDY_HASH'
LOKI_ALLOWED_SOURCES=192.168.1.10/32 192.168.1.20/32 192.168.1.30/32