# Dev Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10500-10599 (see README > Port Allocation).

# --- Ports ---
FORGEJO_HTTP_PORT=10500
FORGEJO_SSH_PORT=10522

# --- User/Group IDs ---
# The data volume must be owned by this UID/GID, or Forgejo may fail to start.
PUID=1000
PGID=1000

# --- Paths ---
FORGEJO_DATA_LOCATION=./forgejo

# --- Forgejo ---
# Pin to a specific Forgejo image tag, e.g. "16" or "16.0.1"
FORGEJO_VERSION=16
