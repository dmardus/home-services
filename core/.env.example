# Core Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10100-10199 (see README > Port Allocation).

# --- Ports ---
PORTAINER_PORT=10100
DOCKHAND_PORT=10110
ARCANE_PORT=10120

# --- User/Group IDs ---
PUID=1000
PGID=1000

# --- Arcane ---
# Only matters once this stack sits behind a real reverse proxy/domain.
ARCANE_APP_URL=http://localhost:10120
# Must be 32 bytes (raw, base64, or hex). Generate with: openssl rand -hex 32
ARCANE_ENCRYPTION_KEY=your_arcane_encryption_key
# Generate with: openssl rand -hex 32
ARCANE_JWT_SECRET=your_arcane_jwt_secret

# --- Secrets ---
# Cloudflare Tunnel token - from the Zero Trust dashboard (Networks > Tunnels)
TUNNEL_TOKEN=your_cloudflare_tunnel_token
