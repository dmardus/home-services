# Core Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10100-10199 (see README > Port Allocation).

# --- Ports ---
PORTAINER_PORT=10100
DOCKHAND_PORT=10110

# --- Secrets ---
# Cloudflare Tunnel token - from the Zero Trust dashboard (Networks > Tunnels)
TUNNEL_TOKEN=your_cloudflare_tunnel_token
