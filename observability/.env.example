# Observability Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10900-10999 (see README > Port Allocation).

# --- Ports ---
GRAFANA_PORT=10900
UPTIMEKUMA_PORT=10901
BESZEL_PORT=10902
SMOKEPING_PORT=10903
PROMETHEUS_PORT=10910
# If you change this, also update the node-exporter target port in config/prometheus.yml
# (that file has no env substitution, so the two must be kept in sync manually).
NODEEXPORTER_PORT=10920

# --- Container user and timezone ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Beszel Agent pairing ---
# Generate these in the Beszel Hub UI (Add System) - they pair this agent with your hub.
# Treat them as secrets: anyone with the token/key can register a rogue agent to your hub.
BESZEL_AGENT_TOKEN=your_beszel_agent_token
BESZEL_AGENT_KEY=your_beszel_agent_public_key
