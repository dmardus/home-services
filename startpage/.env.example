# Startpage Stack
# Copy this file to .env and fill in your own values before running docker compose up.
# Reserved port range for this stack: 10600-10699 (see README > Port Allocation).

# --- Ports ---
HOMEPAGE_PORT=10600

# --- User/Group IDs ---
PUID=1000
PGID=1000

# --- Homepage ---
# Comma-separated list of hosts (with port, if not 80/443) allowed to serve the
# UI. Add your LAN hostname/IP once you access it beyond localhost, e.g.
# HOMEPAGE_ALLOWED_HOSTS=homepage.local,192.168.1.50:10600
HOMEPAGE_ALLOWED_HOSTS=localhost:10600
# --- Homepage Config Location ---
# Location of the homepage config directory on the host machine. This is where
# the homepage config files will be stored. You can change this to any directory
# on your host machine. The default is ./homepage/config, which is relative to the
# docker-compose.yaml file. You can also use an absolute path, e.g. /home/user/homepage/config.
HOMEPAGE_CONFIG_LOCATION=./homepage/config

# Service endpoints
HOMEPAGE_VAR_CADDY_API_URL=http://proxy-caddy:2019
HOMEPAGE_VAR_UNIFI_URL=https://unifi.example.test
HOMEPAGE_VAR_HOMEASSISTANT_URL=https://homeassistant.example.test
HOMEPAGE_VAR_HERMES_URL=https://assistant.example.test
HOMEPAGE_VAR_COCKPIT_URL=https://cockpit.example.test
HOMEPAGE_VAR_HOMEPAGE_URL=https://homepage.example.test
HOMEPAGE_VAR_BESZEL_URL=https://beszel.example.test
HOMEPAGE_VAR_GRAFANA_URL=https://grafana.example.test
# Point directly to SmokePing's final path to avoid redirect-loop false negatives.
HOMEPAGE_VAR_SMOKEPING_URL=https://smokeping.example.test/smokeping/
HOMEPAGE_VAR_DOCKHAND_URL=https://dockhand.example.test
HOMEPAGE_VAR_OPENWEBUI_URL=https://openwebui.example.test
HOMEPAGE_VAR_SEARXNG_URL=https://search.example.test
HOMEPAGE_VAR_SEARXNG_SEARCH_URL=https://search.example.test/search?q=
HOMEPAGE_VAR_ITTOOLS_URL=https://it-tools.example.test
HOMEPAGE_VAR_IMMICH_URL=https://immich.example.test
HOMEPAGE_VAR_JELLYFIN_URL=https://jellyfin.example.test
HOMEPAGE_VAR_NAVIDROME_URL=https://navidrome.example.test

# Weather
HOMEPAGE_VAR_WEATHER_LABEL=Calgary
HOMEPAGE_VAR_WEATHER_LATITUDE=51.05011
HOMEPAGE_VAR_WEATHER_LONGITUDE=-114.08529
HOMEPAGE_VAR_WEATHER_TIMEZONE=America/Edmonton
HOMEPAGE_VAR_WEATHER_UNITS=metric

# Widget credentials — replace locally; never commit real values.
# Unifi: dedicated API key.
HOMEPAGE_VAR_UNIFI_API_KEY=replace_with_unifi_api_key
# Home Assistant: long-lived token for a dedicated restricted dashboard user.
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=replace_with_home_assistant_token
# Homepage's Beszel widget currently requires a superuser; use a dedicated account.
HOMEPAGE_VAR_BESZEL_USERNAME=dashboard@example.test
HOMEPAGE_VAR_BESZEL_PASSWORD=replace_with_beszel_password
# Dockhand: dedicated key
HOMEPAGE_VAR_DOCKHAND_API_KEY=replace_with_dockhand_api_key
# Immich: dedicated key from Settings > API Keys.
HOMEPAGE_VAR_IMMICH_API_KEY=replace_with_immich_api_key
# Jellyfin: dedicated key from Administration Dashboard > Advanced > API Keys.
HOMEPAGE_VAR_JELLYFIN_API_KEY=replace_with_jellyfin_api_key
# Navidrome: creadentials
HOMEPAGE_VAR_NAVIDROME_USERNAME=replace_with_navidrome_username
HOMEPAGE_VAR_NAVIDROME_SALT=replace_with_navidrome_salt
HOMEPAGE_VAR_NAVIDROME_TOKEN=replace_with_navidrome_token